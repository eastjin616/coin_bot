# Database
DATABASE_URL=postgresql://user:password@localhost:5432/coinbot

# 주식 - 미래에셋증권
MIRAE_ASSET_APP_KEY=
MIRAE_ASSET_APP_SECRET=
MIRAE_ASSET_ACCOUNT=

# 코인 - 업비트
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 텔레그램
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# AI 모델 (없으면 랜덤 예측 모드)
VISION_MODEL_PATH=

# LLM API 키 (차트 분석용 - 둘 중 하나만 있으면 됨, Gemini 우선)
# Gemini 무료: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI API: https://platform.openai.com/api-keys
OPENAI_API_KEY=
GROQ_API_KEY=

# 설정
COOLDOWN_MINUTES=5
POLL_INTERVAL_SECONDS=60
STOCK_BUDGET_KRW=50000
COIN_BUDGET_KRW=50000
RUNTIME_PARAMS_PATH=
ORDER_SIZE_RATIO=0.5
RISK_ON_ORDER_SIZE_RATIO=0.2
CAUTION_ORDER_SIZE_RATIO=0.1
RISK_OFF_ORDER_SIZE_RATIO=0.05
MIN_ORDER_AMOUNT_KRW=10000
MAX_ORDER_AMOUNT_KRW=50000
TARGET_POSITION_BUDGET_KRW=50000
STOP_LOSS_PERCENT=5.0
TAKE_PROFIT_PERCENT=0.0
MAX_HOLD_DAYS=10
TIME_STOP_MIN_PNL_PCT=0.0
WEAK_TREND_RSI_BUFFER=7.0
LIVE_DERATING_ENABLED=true
LIVE_DERATING_LOOKBACK_DAYS=30
LIVE_DERATING_MIN_SELL_COUNT=2
LIVE_DERATING_MIN_WIN_RATE_PCT=50.0
LIVE_DERATING_MIN_AVG_PNL_PCT=0.0
LIVE_DERATING_MIN_REALIZED_PNL_KRW=0.0
LOSS_STREAK_COOLDOWN_ENABLED=true
LOSS_STREAK_THRESHOLD=2
LOSS_STREAK_COOLDOWN_DAYS=10
LOSS_STREAK_LOOKBACK_DAYS=30
MANUAL_HOLDING_POLICY=alert_only
MANUAL_HOLDING_MIN_VALUE_KRW=10000

# 분할 매도 (기본 비활성화)
PARTIAL_SELL_ENABLED=false
PARTIAL_SELL_RSI_OFFSET=5.0
PARTIAL_SELL_PCT=50.0

# DCA 분할매수 (기본 비활성화)
DCA_ENABLED=false
DCA_STEP_RSI=5.0
MAX_DCA_COUNT=2
DCA_ORDER_SIZE_RATIO=0.1

# 운영 리스크 캡 (0 = 비활성화)
MAX_OPEN_POSITIONS=12
MAX_BUYS_PER_DAY=48

# (미사용) 대시보드 인증 & CORS
DASHBOARD_API_KEY=
VERCEL_ORIGIN=http://localhost:3000
